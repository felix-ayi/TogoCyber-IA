TOGOCYBER_API_URL=http://localhost:8000
TOGOCYBER_DB_PATH=database/togocyber.sqlite3
# Forward-compatible connection string. Only sqlite:/// is wired today; a
# postgresql:// URL is rejected at startup until the adapter layer is implemented.
DATABASE_URL=
TOGOCYBER_MODELS_DIR=models/artifacts
RETENTION_DAYS=30
# Global per-client request cap per minute. 0 disables the limiter (default). The
# window is in-process only: with several workers/instances the effective limit is
# multiplied, so a shared store (e.g. Redis) is required for a true global cap.
RATE_LIMIT_PER_MINUTE=0
CORS_ALLOWED_ORIGINS=http://localhost:8501
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LOG_LEVEL=INFO
AUTH_SECRET_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# External integrations are OPTIONAL. Leave empty to keep them "not configured";
# the platform never simulates data from an unconfigured source.
ZEEK_LOG_PATH=
SURICATA_EVE_PATH=
SYSLOG_HOST=
SYSLOG_PORT=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SIEM_API_URL=
SIEM_API_TOKEN=
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SLACK_WEBHOOK=
NOTIFICATION_WEBHOOK_URL=